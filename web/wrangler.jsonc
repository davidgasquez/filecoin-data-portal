// Default target is the isolated portal preview Worker on workers.dev. It never touches the apex.
// Every other target is only selected by scripts/deploy.mjs (gated): FDP_SITE picks the portal or explorer
// build, and `production` requires explicit approval.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filecoindataportal-preview",
  "account_id": "fbe814d4a37d3d3d7fcfeec0ab929ff6",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      // Mirrors the live apex Worker: both the custom domain and the zone route exist; keep both.
      "name": "filecoindataportal",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page"
      },
      "routes": [
        { "pattern": "filecoindataportal.xyz", "custom_domain": true },
        { "pattern": "filecoindataportal.xyz/*", "zone_name": "filecoindataportal.xyz" }
      ]
    },
    // Onchain Cloud explorer (FDP_SITE=foc): its own static build in dist-foc.
    "foc-preview": {
      "name": "filecoindataportal-foc-preview",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist-foc",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page"
      }
    },
    "foc-production": {
      "name": "filecoindataportal-foc",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist-foc",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page"
      },
      "routes": [
        { "pattern": "foc.filecoindataportal.xyz", "custom_domain": true }
      ]
    }
  }
}
