---
import { archivedOn } from "../archive"
import { daily, dates } from "../numbers-data"
import { DAY, columnPoints, formatDate, formatDecimal, formatMetricValue, periodLabels, rangePoints, ranges, sparklinePath, type RangeValues } from "../numbers"
import type { NumbersMetric } from "../numbers-sections"

type Props = { chart: NumbersMetric }

const { chart } = Astro.props
const { id, title, description, period: _, source = "daily_network_metrics", columns: sourceColumns, details, ...config } = chart
const columns = sourceColumns ?? [config.y, ...(config.series?.map(({ y }) => y) ?? []), ...(details?.map(({ y }) => y) ?? [])]
const cutoff = Date.parse(archivedOn) - DAY

function metricSummary(metric: NumbersMetric) {
  const points = columnPoints(daily, dates, metric.y)
  const ranged = Object.fromEntries(ranges.map((range) => [range, rangePoints(points, range)]))
  const rangeLabels = Object.fromEntries(ranges.map((range) => {
    const rangePoints = ranged[range]
    return [range, rangePoints.length ? `${formatDate(rangePoints[0][0])}–${formatDate(rangePoints.at(-1)![0])}` : "No observations"]
  })) as RangeValues<string>
  const sparklinePaths = Object.fromEntries(ranges.map((range) => [range, sparklinePath(ranged[range])])) as RangeValues<string>
  const period = periodLabels[metric.period]

  const observed = points.filter((point): point is [number, number] => point[1] != null)
  if (observed.length === 0) {
    return { value: "—", trend: "No observations", meta: period, stale: true, rangeLabels, sparklinePaths, accessibleSummary: "No observations are available." }
  }

  const [latestAt, latest] = observed.at(-1)!
  const lagDays = Math.round((cutoff - latestAt) / DAY)
  const meta = `${period} · ${formatDate(latestAt)}${lagDays > 0 ? ` · ${lagDays}d behind` : ""}`
  // Baseline is the observation exactly 30 UTC days earlier; missing or zero baselines show no change.
  const previous = observed.find(([timestamp]) => timestamp === latestAt - 30 * DAY)
  let trend = observed.length === 1 ? "Single observation" : "No 30d comparison"
  if (previous && metric.format === "percent") {
    const change = (latest - previous[1]) * 100
    trend = `${change > 0 ? "▲ +" : change < 0 ? "▼ " : "■ "}${formatDecimal(change, 2)} pp 30d`
  } else if (previous && previous[1] !== 0) {
    const change = ((latest - previous[1]) / Math.abs(previous[1])) * 100
    trend = `${change > 0 ? "▲ +" : change < 0 ? "▼ " : "■ "}${formatDecimal(change, 2)}% 30d`
  }
  const value = formatMetricValue(latest, metric)

  return {
    value,
    trend,
    meta,
    stale: lagDays > 0,
    rangeLabels,
    sparklinePaths,
    accessibleSummary: `Latest value ${value} (${period}) on ${formatDate(latestAt)}; ${trend}.`,
  }
}

const summary = metricSummary(chart)
const tooltipId = `${id}-description`
const panelId = `${id}-panel`
const titleId = `${id}-title`
const chartSummaryId = `${id}-chart-summary`
const chartUrl = new URL(`/numbers#${id}`, Astro.site).href
const sourceText = source
  ? `Source columns: ${columns.map((column) => `${source}.${column}`).join(", ")}.`
  : "Source: curated count, maintained in the dashboard."
const prompt = `Read ${new URL("/SKILL.md", Astro.site).href} and get the definition, model and upstream assets, and data sample for the "${title}" chart at ${chartUrl}. ${sourceText} Then answer the following question:\n\n`
---

<figure
  id={id}
  class:list={["stat-card", { "is-stale": summary.stale }]}
  data-stat-card
  data-chart={JSON.stringify(config)}
>
  <figcaption class="stat-card__header">
    <span id={titleId} class="stat-card__title" data-chart-title>{title}</span>
    <span class="stat-card__headline">{summary.value}</span>
    <span class="stat-card__tools">
      <span class="stat-card__info-wrap">
        <button type="button" class="stat-card__info" aria-label={`About ${title}`} aria-describedby={tooltipId}>?</button>
        <span class="stat-card__info-tooltip">
          <span id={tooltipId}>{description}</span>
          <span class="stat-card__source">
            Source: {source ? <Fragment><a href={`/datasets#${source}`}>{source}</a>.{columns.join(", ")}</Fragment> : "Curated count."}
          </span>
          <button type="button" class="stat-card__copy-prompt" data-copy={prompt} aria-label={`Copy agent prompt about ${title}`}>
            Ask your agent
          </button>
        </span>
      </span>
      <button type="button" class="stat-card__copy-link" data-chart-copy-link data-copy={chartUrl} data-copy-icon aria-label={`Copy link to ${title}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
      </button>
    </span>
    <button
      type="button"
      class="stat-card__toggle"
      data-chart-toggle
      aria-expanded="false"
      aria-controls={panelId}
      aria-label={`Expand ${title}`}
    >
      +
    </button>
  </figcaption>

  <strong class="stat-card__value">{summary.value}</strong>
  <span class="stat-card__meta">{summary.meta}</span>
  <span class="stat-card__trend">{summary.trend}</span>
  <svg class="stat-card__sparkline" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path
      data-chart-sparkline
      data-range-paths={JSON.stringify(summary.sparklinePaths)}
      d={summary.sparklinePaths["1y"]}
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>

  <div id={panelId} class="stat-card__panel" data-chart-panel hidden>
    <p class="stat-card__description">{description} <span class="stat-card__meta">{summary.meta}.</span></p>
    <p
      id={chartSummaryId}
      class="visually-hidden"
      data-chart-summary
      data-summary-base={summary.accessibleSummary}
      data-range-labels={JSON.stringify(summary.rangeLabels)}
    >
      {summary.accessibleSummary} Daily trend: {summary.rangeLabels["1y"]}.
    </p>
    <div class="stat-card__chart" data-chart-canvas role="img" aria-labelledby={titleId} aria-describedby={chartSummaryId}></div>
    <p class="stat-card__status" data-chart-status aria-live="polite"></p>

    {details && (
      <div class="stat-card__detail-grid">
        {details.map(({ title: detailTitle, description: detailDescription, ...detail }) => (
          <section class="stat-card__detail" data-detail-chart data-chart={JSON.stringify(detail)}>
            <header class="stat-card__detail-header">
              <h3>{detailTitle}</h3>
              <strong data-detail-value>—</strong>
            </header>
            <p>{detailDescription}</p>
            <div class="stat-card__detail-chart" data-chart-canvas role="img" aria-label={`${detailTitle} daily trend`}></div>
          </section>
        ))}
      </div>
    )}
  </div>
</figure>
