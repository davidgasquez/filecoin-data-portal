---
import Layout from '../layouts/Layout.astro'
import Metric from '../components/Metric.astro'
import Comparison from '../components/Comparison.astro'
import DeclaredMetric from '../components/DeclaredMetric.astro'
import { sections } from '../sections'
import { daily, network, quality, providers, quarters, orchestrators } from '../data'
import { latest, series, format, kind, title, number, windowTotal, qualityWindow, atto, percent, grouped as count, epochTime } from '../metrics.mjs'
import * as quarter from '../solstice.mjs'
import { chart } from '../charts.mjs'

const checks = [
  ['Storage probes', 'storage_successes', 'storage_checks'],
  ['Dealbot retrievals', 'retrieval_successes', 'retrieval_checks'],
  ['Sampled piece retrievals', 'sampled_retrieval_successes', 'sampled_retrieval_checks'],
  ['Proving faults', 'proving_periods_faulted', 'proving_periods_closed'],
].map(([label, numerator, denominator]) => ({ label, ...qualityWindow(quality, providers, numerator, denominator) }))
const sampled = checks[2]
const attempted = sampled.rows.filter((row) => row.attempts > 0)
const selected = [...attempted].sort((a, b) => b.attempts - a.attempts).slice(0, 10).sort((a, b) => a.rate - b.rate)
// Dots encode position, not length: crop the shared axis to the nearest 5% below the lowest selected rate.
const axisMin = selected.length ? Math.min(0.95, Math.floor(Math.min(...selected.map((row) => row.rate)) * 20) / 20) : 0
const at = (rate: number) => `left:${((rate - axisMin) / (1 - axisMin) * 100).toFixed(2)}%`
const ticks = [0, 1, 2, 3, 4, 5].map((i) => axisMin + (1 - axisMin) * i / 5)
const pooled = sampled.attempts ? sampled.successes / sampled.attempts : null
const showPooled = pooled != null && pooled >= axisMin

const onboarded = windowTotal(daily, 'onboarded_pibs')
const removed = windowTotal(daily, 'removed_pibs')
const burn = latest(daily, 'burn_coverage_ratio')
const burnRow = daily.find((row) => row.date === burn?.date)
const rewardRow = daily.findLast((row) => ['minted_rewards_fil', 'miner_rewards_fil', 'service_rewards_fil', 'emission_burn_fil'].every((key) => number(row[key]) != null))

// Solstice: values as published; the page only labels them. Atto amounts stay exact BigInt until display rounding.
const usd = (value: unknown) => quarter.usd(value) ?? 'Unknown'
const fil = (value: unknown) => value == null ? 'Unknown' : `${atto(value, 4)} FIL`
const gate = (q: (typeof quarters)[number]) => {
  const state = quarter.gate(q)
  return state == null ? 'Not observed' : Number(q.quarter) === 1 ? state
    : `${state} ${String(q.gate_checked_at).slice(0, 10)} · ${usd(q.gate_threshold_atto_usd)} threshold`
}

const auditColumns = network.columns.filter((column) => column.name !== 'date' && !column.name.endsWith('_json'))
const solsticeAfter = sections.some((section) => section.id === 'provider-quality') ? 'provider-quality' : sections.at(-1)?.id
// The sections in page order with short hints: listed as the introduction's contents and as the header's Numbers menu.
const hints: Record<string, string> = {
  'key-metrics': 'Pay run rate, burn coverage',
  'filecoin-onchain-cloud': 'Payments, warm storage, PDP',
  'provider-quality': 'Probes, retrievals, faults',
  solstice: 'Quarterly payment volume',
  power: 'Onboarding, network power',
  activity: 'Transactions, value, gas',
  protocol: 'Burn, supply, rewards, fees',
  markets: 'FIL price, volume, DeFi',
  'all-metrics': 'Every column, full history',
}
const contents = [...sections.flatMap((section) => [[section.id, section.title], ...(section.id === solsticeAfter ? [['solstice', 'Solstice']] : [])]), ['all-metrics', 'All metrics']]
  .map(([id, title]) => ({ id, title, hint: hints[id] }))
---
<Layout title="Filecoin in numbers" description="Daily Filecoin network, storage, payments, provider, and token metrics with sources." sections={contents}>
  <div class="numbers">
  <header class="numbers-head" id="contents">
    <div class="numbers-intro">
      <h1>Filecoin in numbers</h1>
      <p class="numbers-lede">Daily network, storage, payment, provider and token metrics. Every chart carries its definition, source and last observed day.</p>
      <fieldset class="chart-range" data-chart-range hidden aria-describedby="range-scope">
        <legend class="meta">Chart history</legend>
        <span class="range-options">{[['6m', '6m'], ['1y', '1y'], ['all', 'All']].map(([value, label]) => <label><input type="radio" name="numbers-range" value={value} checked={value === '6m'} /><span>{label}</span></label>)}</span>
      </fieldset>
      <p class="range-status meta" data-range-status role="status" hidden></p>
      <span class="sr" id="range-scope">Time-series history, ending at each chart’s last observation. Comparisons retain their stated windows; the metric ledger always shows full history.</span>
    </div>
    <nav class="numbers-toc" aria-label="Contents">
      <ol>{contents.map(({ id, title, hint }) => <li><a href={`#${id}`}><span>{title}</span> <span class="meta">{hint}</span></a></li>)}</ol>
    </nav>
  </header>

  {sections.map((section) => <Fragment>
    <section class="board" id={section.id} aria-labelledby={`${section.id}-title`}>
      <h2 id={`${section.id}-title`}>{section.title}</h2>
      {section.groups.map((group, index) => <div class="board-group">
        {group.title && <h3 class="group-title">{group.title}</h3>}
        <div class="chart-grid">
          {group.charts.filter(metric => metric.y !== 'terminated_pibs').map(metric => metric.source === null
            ? <DeclaredMetric id={metric.id} headingLevel={group.title ? 4 : 3} />
            : <Metric metric={metric} label={metric.y === 'onboarded_pibs' ? 'Onboarded & terminated' : undefined} negative={metric.y === 'onboarded_pibs' ? group.charts.find(item => item.y === 'terminated_pibs') : undefined} headingLevel={group.title ? 4 : 3} />)}
          {index === section.groups.length - 1 && section.id === 'power' && <Fragment>
            <Comparison label="Onboarded vs removed, 30 days" rows={[
              { label: 'Onboarded', value: onboarded.count ? onboarded.value : null, column: 'onboarded_pibs' },
              { label: 'Removed', value: removed.count ? removed.value : null, column: 'removed_pibs' },
            ]} note={`Onboarded ${onboarded.start} → ${onboarded.end} (${onboarded.count}/30 days); removed ${removed.start} → ${removed.end} (${removed.count}/30 days). Removed includes expired and terminated.`} />
          </Fragment>}
          {index === section.groups.length - 1 && section.id === 'protocol' && <Fragment>
            <Comparison label="Trailing-year burn and spending" rows={[
              { label: 'Non-emission burn', value: burnRow?.annual_non_emission_burn_usd, column: 'value_usd' },
              { label: 'Distributed rewards', value: burnRow?.annual_distributed_rewards_usd, column: 'value_usd' },
              { label: 'Public goods funding', value: burnRow?.annual_pgf_deployments_usd, column: 'value_usd' },
            ]} note={`${burn?.date ?? 'Not observed'} · burn and rewards cover ${burnRow?.annual_coverage_days ?? 'unknown'}/365 complete days. Independent amounts, not shares.`} />
            <Comparison label="Where minted rewards go" rows={[
              { label: 'Miner rewards', value: rewardRow?.miner_rewards_fil, column: 'value_fil' },
              { label: 'Service rewards', value: rewardRow?.service_rewards_fil, column: 'value_fil' },
              { label: 'Emission burn', value: rewardRow?.emission_burn_fil, column: 'value_fil' },
            ]} note={`${rewardRow?.date ?? 'Not observed'} · of ${format(rewardRow?.minted_rewards_fil, 'minted_rewards_fil')} minted that day.`} />
          </Fragment>}
        </div>
      </div>)}

      {section.id === 'provider-quality' && <div class="board-group">
        <h3 class="group-title">By provider</h3>
        <figure class="dot-plot">
          <figcaption class="meta">Sampled piece retrieval success, {sampled.start} → {sampled.end}. The {selected.length} providers with the most attempts; skips excluded. Axis starts at {percent(axisMin)}, read dot position.{showPooled && ` Tall rule: pooled rate across all ${attempted.length} providers, ${percent(pooled)}.`}</figcaption>
          <div class="provider-list"><div class="dot-axis meta" aria-hidden="true"><span>Provider</span><span class="dot-ends"><span>{percent(axisMin)}</span><span>100%</span></span><span>Successes / attempts</span></div>
          {selected.length ? selected.map((row) => <div class="provider-row">
            <span>{row.name}<span class="meta mono"> #{row.id}</span></span>
            <span class="dot-track" role="img" aria-label={`${row.name}: ${percent(row.rate)}`}>{ticks.map((tick) => <i style={at(tick)} />)}{showPooled && <b style={at(pooled!)} />}<span class="dot" style={at(row.rate)} /></span>
            <span class="numeric">{percent(row.rate)} <span class="meta">{count(row.successes)} / {count(row.attempts)}</span></span>
          </div>) : <p>No sampled retrieval attempts observed.</p>}
          </div>
        </figure>
        <details class="audit" id="provider-comparison"><summary>All providers, all four checks (30 days)</summary>
          <p class="meta">Pooled rates divide total successes (or faults) by total attempts (or closed periods), not averages of provider rates. Synthetic probes, not client traffic. <a href="/datasets/daily_provider_quality">Definitions &amp; source</a>.</p>
          <div class="check-grid">{checks.map((check) => <section>
            <h4>{check.label}</h4>
            <p class="meta">{check.start ?? 'Unknown'} → {check.end ?? 'unknown'} · pooled {percent(check.attempts ? check.successes / check.attempts : null)}</p>
            <div class="table-scroll" tabindex="0" role="region" aria-label={`${check.label} by provider`}><table>
              <thead><tr><th scope="col">Provider</th><th scope="col" class="numeric">Rate</th><th scope="col" class="numeric">{check.label === 'Proving faults' ? 'Faulted / closed' : 'Successes / attempts'}</th></tr></thead>
              <tbody>{check.rows.map((row) => <tr><th scope="row">{row.name} <span class="mono meta">#{row.id}</span></th><td class="numeric">{percent(row.rate)}</td><td class="numeric">{count(row.successes)} / {count(row.attempts)}</td></tr>)}</tbody>
            </table></div>
          </section>)}</div>
        </details>
      </div>}

    </section>

    {section.id === solsticeAfter && <section class="board" id="solstice" aria-labelledby="solstice-title">
      <h2 id="solstice-title">Solstice</h2>
      <p class="meta board-note">Quarterly payment volume as observed onchain; provisional until bound. Amounts are exact atto values rounded for display. <a href="/datasets/service_quarters">Definitions &amp; source</a>.</p>
      {quarters.length ? <div class="table-scroll" tabindex="0" role="region" aria-label="Solstice quarters"><table class="solstice">
        <thead><tr><th scope="col">Quarter</th><th scope="col">Phase</th><th scope="col">Observed through</th><th scope="col" class="numeric">Bound volume</th><th scope="col">Gate</th><th scope="col">Shares</th></tr></thead>
        <tbody>{quarters.map((q) => <tr id={`solstice-q${q.quarter}`}>
          <th scope="row">Q{q.quarter} <span class="mono meta">{q.start_block}–{q.end_block}</span></th>
          <td>{quarter.phase(q)}</td>
          <td class="mono">{q.as_of_block == null ? 'Unknown' : <Fragment>block {q.as_of_block}<span class="meta block-time">{epochTime(q.as_of_block) ?? 'unknown time'} UTC</span></Fragment>}</td>
          <td class="numeric">{q.is_bound ? usd(q.bound_volume_atto_usd) : <span class="null">Not bound</span>}</td>
          <td>{gate(q)}</td>
          <td>{q.shares_submitted_at == null ? <span class="null">No event (all-zero submissions emit none)</span> : `${usd(q.shares_total_atto_usd)} · ${q.share_recipients} recipients`}</td>
        </tr>)}</tbody>
      </table></div> : <p>No quarters observed.</p>}
      {orchestrators.length > 0 && <details class="audit"><summary>Orchestrators by quarter</summary>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Solstice orchestrators"><table class="solstice">
          <thead><tr><th scope="col">Quarter</th><th scope="col">Orchestrator</th><th scope="col" class="numeric">Calculated volume</th><th scope="col">Coverage</th><th scope="col" class="numeric">Reported</th><th scope="col" class="numeric">Bound</th><th scope="col" class="numeric">Pending FIL</th></tr></thead>
          <tbody>{orchestrators.map((o) => <tr>
            <td>Q{o.quarter}</td>
            <th scope="row" class="mono">{o.orchestrator}{o.is_removed_in_quarter && <span class="meta"> removed</span>}</th>
            <td class="numeric">{usd(o.volume_atto_usd)}</td>
            <td>{o.is_complete ? 'Complete' : <span class="null">Partial · block {o.volume_as_of_block ?? 'unknown'}</span>}</td>
            <td class="numeric">{o.reported_volume_atto_usd == null ? <span class="null">Not reported</span> : usd(o.reported_volume_atto_usd)}{Number(o.corrections) > 0 && <span class="meta"> · {o.corrections} corrections</span>}</td>
            <td class="numeric">{o.is_bound ? usd(o.bound_volume_atto_usd) : <span class="null">Not bound</span>}</td>
            <td class="numeric">{fil(o.fil_pending_atto_fil)}</td>
          </tr>)}</tbody>
        </table></div>
      </details>}
    </section>}
  </Fragment>)}

  <section class="board" id="all-metrics" aria-labelledby="all-metrics-title">
    <h2 id="all-metrics-title">All network metrics</h2>
    <p class="meta board-note">Every column of <a href="/datasets/daily_network_metrics">daily_network_metrics</a>: latest non-null value, its date, and full history. Missing is never zero. FIL shown to at most 6 decimals. Early burn-coverage history has partial trailing-year windows; compare with annual coverage days. <a href="/numbers-history.json">All plotted history (JSON)</a>.</p>
    <details class="audit"><summary>Inspect all {auditColumns.length} network metrics</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="All network metrics"><table class="metric-ledger"><caption class="sr">Daily network metrics: latest known values and full-history miniatures</caption><thead><tr><th scope="col">Metric &amp; definition</th><th scope="col" class="numeric">Latest</th><th scope="col">Date (UTC)</th><th scope="col">History</th></tr></thead><tbody>
        {auditColumns.map((column) => { const value = latest(daily, column.name); return <tr><th scope="row"><details><summary>{title(column.name)}</summary><p>{column.description}</p><a class="mono source-link" href={`/datasets/daily_network_metrics#${column.name}`}>{column.name}</a></details></th><td class="numeric">{format(value?.value, column.name, false)}</td><td class="mono">{value?.date ?? 'Not observed'}</td><td class="spark" set:html={chart(series(daily, column.name, 0), column.name, kind(column.name), { mini: true })} /></tr> })}
      </tbody></table></div>
    </details>
  </section>
  </div>
</Layout>
<script>
  import '../numbers-ranges'
  import '../numbers-nav'
  import '../numbers-links'
</script>
