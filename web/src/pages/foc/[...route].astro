---
import Layout from '../../layouts/Layout.astro'
import { routes, readFoc, type FocRoute } from '../../foc/data'
import { render } from '../../foc/pages'
import { resetIds, url } from '../../foc/ui'
import '../../foc/foc.css'

export function getStaticPaths() {
  return routes.map((entry) => ({ params: { route: entry.route }, props: { entry } }))
}
const { entry } = Astro.props as { entry: FocRoute }
resetIds()
const page = render[entry.kind](readFoc(entry.file))
const current = ({ provider: 'providers', dataset: 'datasets', rail: 'rails', address: 'clients' } as Record<string, string>)[entry.kind] ?? entry.kind
const nav = [['overview', 'Overview'], ['providers', 'Providers'], ['datasets', 'Data sets'], ['rails', 'Rails'], ['clients', 'Clients'], ['operators', 'Operators'], ['solstice', 'Solstice']]
---
<Layout title={entry.kind === 'overview' ? page.title : `${page.title} · Onchain Cloud`} description={page.description}>
  <div class="foc">
    <nav class="foc-nav" aria-label="Onchain Cloud">
      <div class="foc-links">
        {nav.map(([kind, label]) => <a href={url(kind === 'overview' ? '' : kind)} aria-current={kind === current ? (kind === entry.kind ? 'page' : 'true') : undefined}>{label}</a>)}
      </div>
      <form class="foc-search" role="search" action="/foc" hidden>
        <label class="sr" for="foc-q">Search providers, ids and addresses</label>
        <input id="foc-q" type="search" role="combobox" aria-expanded="false" aria-controls="foc-results" aria-autocomplete="list" placeholder="Provider, id or 0x address" autocomplete="off" spellcheck="false" />
        <kbd class="meta" aria-hidden="true">/</kbd>
        <div id="foc-results" role="listbox" aria-label="Search results" hidden></div>
        <p class="foc-no-results meta" role="status" hidden></p>
      </form>
    </nav>
    <Fragment set:html={page.html} />
  </div>
</Layout>
<script>import '../../foc/client'</script>
