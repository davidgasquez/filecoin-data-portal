---
import Layout from '../layouts/Layout.astro'
import { daily, datasets, dataUrl } from '../data'
import { repoUrl } from '../site.mjs'
import { latest, format, series, kind } from '../metrics.mjs'
import { draw } from '../charts.mjs'

// Current build origin (SITE_URL), so previews point agents at their own SKILL.md.
const skill = new URL('/SKILL.md', Astro.site ?? 'https://filecoindataportal.xyz').href
const prompt = `Read ${skill} and tell me which providers onboarded more data last week`
const sql = `select
  date,
  raw_power_pibs,
  onboarded_pibs
from '${dataUrl}/daily_network_metrics.parquet'
order by date desc
limit 7;`
const headline = [
  ['raw_power_pibs', 'Raw storage power'],
  ['pdp_unique_bytes', 'Unique PDP data'],
  ['warm_storage_billing_payers', 'Warm storage billing payers'],
  ['filecoin_pay_gross_payment_volume_run_rate_usd', 'Filecoin Pay run rate'],
  ['burn_coverage_ratio', 'Burn coverage'],
  ['fil_token_price_avg_usd', 'FIL price, daily average'],
].map(([column, label]) => ({ column, label, ...latest(daily, column) }))

// Hero lineage: a simplified, true slice of the asset graph in ../assets (raw → model → main → /numbers).
type Node = { id: string; label: string; href: string; mono?: boolean; svg?: string }
const assets = `${repoUrl}/tree/main/assets`
const shown = ['daily_network_metrics', 'daily_provider_quality']
const days = 180
const mini = (key: string) => draw(series(daily, key, days), key, kind(key), { mini: true })?.svg ?? ''
const stages: { label: string; nodes: Node[] }[] = [
  { label: 'Sources', nodes: [
    { id: 'lily', label: 'Lily chain state', href: `${assets}/raw/lily` },
    { id: 'riba', label: 'FEVM event logs', href: `${assets}/raw/riba` },
    { id: 'probelab', label: 'Dealbot checks', href: `${assets}/raw/probelab` },
    { id: 'rpc', label: 'RPC and APIs', href: `${assets}/raw` },
    { id: 'markets', label: 'Market data', href: `${assets}/raw/defillama` },
  ] },
  { label: 'Models', nodes: ['network', 'foc', 'pay', 'defi'].map((id) => ({ id, label: id, href: `${assets}/model/${id}`, mono: true })) },
  { label: 'Datasets', nodes: [
    ...shown.map((id) => ({ id, label: id, href: `/datasets/${id}`, mono: true })),
    { id: 'more', label: 'more datasets', href: '/datasets' },
  ] },
  { label: 'Charts', nodes: [
    ['raw_power_pibs', 'Raw storage power'],
    ['onboarded_pibs', 'Data onboarded'],
    ['filecoin_pay_gross_payment_volume_run_rate_usd', 'Filecoin Pay run rate'],
    ['provider_retrieval_success_rate', 'Retrieval success'],
  ].map(([id, label]) => ({ id, label, href: `/numbers#${id}`, svg: mini(id) })) },
]
const links = [
  'lily network', 'riba network', 'riba foc', 'riba pay', 'probelab foc', 'rpc network', 'rpc foc', 'rpc pay', 'markets defi',
  'network daily_network_metrics', 'foc daily_network_metrics', 'pay daily_network_metrics', 'defi daily_network_metrics',
  'foc daily_provider_quality', 'network more', 'foc more', 'pay more',
  'daily_network_metrics raw_power_pibs', 'daily_network_metrics onboarded_pibs', 'daily_network_metrics filecoin_pay_gross_payment_volume_run_rate_usd',
  'daily_provider_quality provider_retrieval_success_rate',
].map((pair) => pair.split(' '))
// Edges into stage i, in a 100×100 box spanning the gap before it. Nodes sit at the centres of equal rows.
const edges = (i: number) => {
  const from = stages[i - 1].nodes.map((node) => node.id), to = stages[i].nodes.map((node) => node.id)
  const y = (list: string[], id: string) => ((list.indexOf(id) + 0.5) / list.length * 100).toFixed(2)
  return links.filter(([a, b]) => from.includes(a) && to.includes(b))
    .map(([a, b]) => `M0,${y(from, a)} C50,${y(from, a)} 50,${y(to, b)} 100,${y(to, b)}`)
}
const daily_ = datasets.filter((dataset) => dataset.id.startsWith('daily_'))
const other = datasets.filter((dataset) => !dataset.id.startsWith('daily_'))
---

<Layout title="Filecoin Data Portal" description="Open Filecoin datasets, updated daily. Query them with SQL, ask your agent, or read the numbers.">
  <header class="hero">
    <div class="hero-copy">
      <h1>Filecoin Data Portal</h1>
      <p>Daily Parquet datasets on storage, payments, providers, and the chain. Query them with SQL, hand them to your agent, or read the numbers.</p>
      <div class="actions">
        <a class="button primary" href="/datasets">Datasets</a>
        <a class="button" href="/numbers">Numbers</a>
      </div>
    </div>

    <figure class="flow" aria-label="Asset graph from sources to charts">
      <ol class="flow-stages">
        {stages.map((stage, i) => (
          <li class="flow-stage" aria-label={stage.label}>
            <p class="flow-label meta" aria-hidden="true">{stage.label}</p>
            <div class="flow-body">
              {i > 0 && (
                <svg class="flow-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  {edges(i).map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
                </svg>
              )}
              <ul class="flow-nodes" style={`--rows: ${stage.nodes.length}`}>
                {stage.nodes.map((node) => (
                  <li class:list={['flow-node', { 'flow-chart': node.svg, 'flow-end': i < stages.length - 1 && !links.some(([a]) => a === node.id) }]}>
                    <a class:list={{ mono: node.mono }} href={node.href}>{node.label}</a>
                    {node.svg && <span class="flow-spark" aria-hidden="true" set:html={node.svg} />}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </figure>
  </header>

  <div class="home-grid">
    <section class="home-block" aria-labelledby="quickstart">
      <h2 id="quickstart">Get Answers</h2>
      <section class="quickstart-path" aria-labelledby="ask-agent">
        <h3 id="ask-agent">Paste this into your favorite agent</h3>
        <div class="copy prompt">
          <pre tabindex="0" role="region" aria-label="Agent prompt"><code>Read <a href={skill}>{skill}</a> and tell me which providers onboarded more data last week</code></pre>
          <button class="button" type="button" data-copy={prompt} hidden>Copy</button>
        </div>
      </section>
      <section class="quickstart-path" aria-labelledby="sql">
        <h3 id="sql"><a href="/docs">Query it yourself</a></h3>
        <div class="copy prompt">
          <pre tabindex="0" role="region" aria-label="DuckDB query"><code>{sql}</code></pre>
          <button class="button" type="button" data-copy={sql} hidden>Copy</button>
        </div>
      </section>
    </section>

    <section class="home-block" aria-labelledby="latest">
      <h2 id="latest"><a href="/numbers">Numbers</a></h2>
      <dl class="facts home-facts">
        {headline.map(({ column, label, value, date }) => (
          <div><dt><a href={`/numbers#${column}`}>{label}</a></dt><dd>{format(value, column)}<span class="meta">{date ?? 'Not observed'}</span></dd></div>
        ))}
      </dl>
    </section>
  </div>

  <section class="home-block home-data" aria-labelledby="data">
    <div class="home-data-lede">
      <h2 id="data"><a href="/datasets">Datasets</a></h2>
      <p>Public tables, each a Parquet file you can query directly. Dataset pages list columns and a sample, and link the <a href={`${repoUrl}/tree/main/assets/main`}>SQL that builds them</a>.</p>
    </div>
    <dl class="home-tables">
      <div><dt class="meta">Daily</dt><dd>{daily_.map((dataset) => <a class="mono" href={`/datasets/${dataset.id}`}>{dataset.id}</a>)}</dd></div>
      <div><dt class="meta">Entities and events</dt><dd>{other.map((dataset) => <a class="mono" href={`/datasets/${dataset.id}`}>{dataset.id}</a>)}</dd></div>
    </dl>
  </section>
</Layout>
