---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import { portal, repoUrl } from '../data'
import '../styles.css'

// `sections` turns the Numbers item into that page's section menu; a `nav` slot replaces the primary navigation.
interface Props { title: string; description?: string; sections?: { id: string; title: string }[] }
const site = 'Filecoin Data Portal'
const { title, description = 'Open Filecoin data: daily numbers and a searchable dataset catalog.', sections } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
// Build origin from Astro.site (SITE_URL); only the production origin is indexable.
const origin = Astro.site ?? new URL('https://filecoindataportal.xyz')
const url = new URL(path, origin).href
const indexable = !import.meta.env.DEV && origin.origin === 'https://filecoindataportal.xyz'
const archiveUrl = process.env.ARCHIVE_URL || 'https://old.filecoindataportal.xyz'
const current = (href: string) => path === href ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined
// The explorer swaps its pages in place (no animation); other sections keep regular navigation.
const explorer = path === '/foc' || path.startsWith('/foc/')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved preference before first paint; otherwise follow the system.
      try {
        const theme = localStorage.getItem('fdp-theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    {!indexable && <meta name="robots" content="noindex" />}
    <title>{title === site ? site : `${title} · ${site}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    {explorer && <ClientRouter fallback="swap" />}
    {explorer && <style is:inline set:html="::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none}" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
        <svg viewBox="0 0 512 512" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M298.736 21.016c-99.298 0-195.928 104.647-215.83 233.736-7.074 45.887-3.493 88.68 8.512 124.787-4.082-6.407-7.92-13.09-11.467-20.034-16.516-32.335-24.627-65.378-25-96.272-11.74 36.254-8.083 82.47 14.482 126.643 27.7 54.227 81.563 91.94 139.87 97.502 5.658.725 11.447 1.108 17.364 1.108 99.298 0 195.93-104.647 215.83-233.736 9.28-60.196.23-115.072-22.133-156.506 21.625 21.867 36.56 45.786 44.617 69.496.623-30.408-14.064-65.766-44.21-95.806-33.718-33.598-77.227-50.91-114.995-50.723-2.328-.118-4.67-.197-7.04-.197zm-5.6 36.357c40.223 0 73.65 20.342 95.702 53.533 15.915 42.888 12.51 108.315.98 147.858-16.02 54.944-40.598 96.035-79.77 126.107-41.79 32.084-98.447 24.39-115.874-5.798-1.365-2.363-2.487-4.832-3.38-7.385 11.724 14.06 38.188 14.944 61.817 1.3 25.48-14.71 38.003-40.727 27.968-58.108-10.036-17.384-38.826-19.548-64.307-4.837-9.83 5.676-17.72 13.037-23.14 20.934.507-1.295 1.043-2.59 1.626-3.88-18.687 24.49-24.562 52.126-12.848 72.417 38.702 45.923 98.07 25.503 140.746-6.426 37.95-28.392 72.32-73.55 89.356-131.988 1.265-4.34 2.416-8.677 3.467-13.008-.286 2.218-.59 4.442-.934 6.678-16.807 109.02-98.412 197.396-182.272 197.396-35.644 0-65.954-15.975-87.74-42.71-26.492-48.396-15.988-142.083 4.675-185.15 26.745-55.742 66.133-122.77 134.324-116.804 46.03 4.027 63.098 58.637 39.128 116.22-8.61 20.685-21.192 39.314-36.21 54.313 24.91-16.6 46.72-42.13 59.572-73 23.97-57.583 6.94-113.422-39.13-116.805-85.737-6.296-137.638 58.55-177.542 128.485-9.21 19.9-16.182 40.35-20.977 60.707.494-7.435 1.312-14.99 2.493-22.652C127.67 145.75 209.275 57.373 293.135 57.373z"/></svg>
        <span>filecoindataportal.xyz</span>
      </a>
      {Astro.slots.has('nav') ? <slot name="nav" /> : <nav class="site-nav" aria-label="Primary">
        {portal.map(([href, label]) => sections && href === '/numbers'
          ? <details class="nav-menu"><summary aria-current={current(href)}><span>{label}</span><span class="nav-current" data-section-current></span><span aria-hidden="true">▾</span></summary>
              <nav aria-label="Sections" data-section-nav><a href="#contents">Contents</a>{sections.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)}</nav>
            </details>
          : <a href={href} aria-current={current(href)}>{label}</a>)}
      </nav>}
      <button class="theme-toggle" type="button" data-theme-toggle hidden>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
      </button>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer shell">
      <p class="meta">Built by <a href="https://davidgasquez.com/">David Gasquez</a> · Code under the <a href={`${repoUrl}/blob/main/LICENSE`}>MIT license</a></p>
      <nav class="meta" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/llms.txt">llms.txt</a>
        <a href={archiveUrl}>Previous site</a>
        <a href={`${repoUrl}/issues`}>Issues</a>
        <a href={repoUrl}>GitHub repository</a>
      </nav>
    </footer>
    <script>
      import '../theme'
      import '../interactions'
    </script>
  </body>
</html>
