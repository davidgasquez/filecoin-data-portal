---
import { declaredMetrics } from '../sections'
import { repoUrl } from '../site.mjs'
interface Props { id: string; headingLevel?: 3 | 4 }
const { id, headingLevel = 3 } = Astro.props
const metric = declaredMetrics.find(item => item.id === id)!
const Heading = `h${headingLevel}` as 'h3' | 'h4'
---
<div class="metric declared-metric" id={metric.id} data-primary-metric={metric.y}>
  <figure class="chart" id={metric.y} data-metric={metric.y} data-declared-value={metric.value}>
    <div class="chart-heading">
      <details class="metric-info">
        <summary><Heading>{metric.title}</Heading><span class="meta">Info</span></summary>
        <div class="metric-info-body">
          <p>{metric.description}</p>
          <p>This is the legacy page’s declared zero, not a measured daily count. No client registry, dated observations, or historical series are available. The flat zero line stays constant in every range.</p>
          <p class="meta">Source: <a href={`${repoUrl}/blob/7793d6eeb848f0c38676858ff9a147f0ecce7779/web/src/numbers-data.ts#L29`}>legacy Numbers configuration</a>, which supplies a hardcoded zero.</p>
          <p class="meta chart-link">Link <a href={`#${metric.id}`}>#{metric.id}</a> <button class="button" type="button" data-copy-link={metric.id} aria-label={`Copy link to ${metric.title}`} hidden>Copy link</button><span role="status"></span></p>
        </div>
      </details>
      <span class="chart-value">{metric.value}</span>
    </div>
    <svg class="declared-line" viewBox="0 0 640 144" preserveAspectRatio="none" role="img" aria-label={`${metric.title}: constant ${metric.value}, declared rather than measured history`}>
      <path class="series" d="M3,140H637" stroke-width="1.8" vector-effect="non-scaling-stroke" />
    </svg>
    <p class="meta">Declared value · no dated history</p>
  </figure>
</div>
<style>
  .declared-line { margin: 0; }
</style>
