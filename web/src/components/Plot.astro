---
import { daily, datasets } from '../data'
import { chart, geometry, scaleNote } from '../charts.mjs'
import { latest, series, format, kind, align, within, defaultRange } from '../metrics.mjs'
// `negative`: a second flow drawn below zero on the same days (e.g. terminated under onboarded), never netted.
// `seriesLabel` names the above-zero series when the heading covers both.
// `slug`: this chart's link anchor (the legacy metric id for primary charts; the column otherwise).
interface Negative { column: string; label: string; description?: string }
interface Props {
  column: string; label: string; focal?: boolean; note?: string
  description?: string; source?: string; columns?: string[]; chartKind?: string; headingLevel?: 3 | 4 | 5; negative?: Negative; seriesLabel?: string; slug?: string
}
const { column, label, focal = false, note, description, source = 'daily_network_metrics', columns, chartKind, headingLevel = 3, negative, seriesLabel = label, slug = column } = Astro.props as Props
const Heading = `h${headingLevel}` as 'h3' | 'h4' | 'h5'
const type = chartKind ?? kind(column)
const value = latest(daily, column)
const negativeValue = negative && latest(daily, negative.column)
// Full history aligned first, so the default window is the same one the range control later recomputes.
let full = series(daily, column, 0), negativeFull = negative && series(daily, negative.column, 0)
if (negativeFull) [full, negativeFull] = align(full, negativeFull)
const points = within(full, defaultRange)
const negativePoints = negativeFull && within(negativeFull, defaultRange)
const g = geometry(points, type, 640, 144, false, negativePoints)
const sourceColumns = columns ?? [source === 'daily_provider_quality' ? column.replace(/^provider_/, '') : column]
const sourceDataset = datasets.find((item) => item.id === source)
const sourceColumn = (name: string) => sourceDataset?.columns.find((item) => item.name === name)
const sourceHref = (name: string) => `/datasets/${source}${sourceColumn(name) ? `#${name}` : ''}`
const unavailable = sourceColumns.some(name => !sourceColumn(name))
const define = (name: string) => sourceColumn(name)?.description
const definition = description ?? define(sourceColumns[0])
const negativeDefinition = negative && (negative.description ?? define(negative.column))
---
<figure class="chart" id={column} data-metric={column} data-range data-negative-metric={negative?.column}>
  <div class="chart-heading">
    <details class="metric-info">
      <summary><Heading>{label}</Heading><span class="meta">Info</span></summary>
      <div class="metric-info-body">
        <p>{negative && `Above zero, ${seriesLabel}: `}{definition}</p>
        {negative && <p>Below zero, {negative.label}: {negativeDefinition} Drawn downward for direction; source values are positive amounts, not netted.</p>}
        {note && <p>{note}</p>}
        <p class="meta">Latest non-null observation: {negative ? `${column} ${value?.date ?? 'not observed'}; ${negative.column} ${negativeValue?.date ?? 'not observed'}` : value?.date ?? 'not observed'} (UTC).{column.endsWith('_fil') && ' FIL display precision: at most 6 decimals.'}</p>
        <p class="meta" data-chart-scale>{g && `Shown ${points[0].date} → ${points.at(-1)!.date}. ${scaleNote(g, column, type)}`}</p>
        {unavailable && <p class="meta">These source columns are not available in this snapshot.</p>}
        <p class="meta">Source: <a href={sourceHref(sourceColumns[0])}>{source}</a></p>
        <p class="meta">{sourceColumns.join(' · ')}{negative && <Fragment> · <a href={sourceHref(negative.column)}>{negative.column}</a> (below zero)</Fragment>}</p>
        <p class="meta chart-link">Link <a href={`#${slug}`}>#{slug}</a> <button class="button" type="button" data-copy-link={slug} aria-label={`Copy link to ${label}`} hidden>Copy link</button><span role="status"></span></p>
      </div>
    </details>
    <span class="chart-value">{format(value?.value, column)}</span>
  </div>
  <div set:html={chart(points, column, type, { focal, label: seriesLabel, interactive: true, negative: negative && { points: negativePoints, key: negative.column, label: negative.label } })} />
  {negative && <p class="chart-legend meta">Above zero: {seriesLabel} {format(value?.value, column)}. Below zero: {negative.label} {format(negativeValue?.value, negative.column)}.{negativeValue?.date !== value?.date && ` Latest ${value?.date ?? 'not observed'} and ${negativeValue?.date ?? 'not observed'}.`}</p>}
</figure>
<script>import '../hover'</script>
<style>
  /* Below the dates, so the combined plot starts level with its row. */
  .chart-legend { margin-top: 0.25rem; }
</style>
