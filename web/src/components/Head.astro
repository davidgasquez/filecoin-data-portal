---
import { Font } from "astro:assets"

interface Props {
  title: string
  author?: string
  description: string
  image?: string
  canonicalUrl?: string
}

const {
  title,
  author = "Nexus Data Labs",
  description,
  image = "/banner.png",
  canonicalUrl = Astro.url.pathname,
} = Astro.props

const siteUrl = import.meta.env.SITE || Astro.site || Astro.url
const siteRootUrl = new URL("/", siteUrl).toString()
const fullUrl = new URL(canonicalUrl, siteUrl).toString()
const imageUrl = new URL(image, siteUrl).toString()
const maintainerId = `${siteRootUrl}#maintainer`

const jsonData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteRootUrl}#website`,
      name: "Filecoin Data Portal",
      description: "Open data platform for the Filecoin ecosystem.",
      url: siteRootUrl,
      creator: { "@id": maintainerId },
    },
    {
      "@type": "DataCatalog",
      "@id": `${siteRootUrl}#catalog`,
      name: "Filecoin Data Portal datasets",
      description: "Open Filecoin datasets published as Parquet files and updated daily.",
      url: new URL("/datasets", siteUrl).toString(),
      license: "https://creativecommons.org/public-domain/cc0/",
      isAccessibleForFree: true,
      creator: { "@id": maintainerId },
    },
    {
      "@type": "Person",
      "@id": maintainerId,
      name: "David Gasquez",
      url: "https://davidgasquez.com/",
      sameAs: ["https://github.com/davidgasquez"],
    },
  ],
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="author" content={author} />
<meta name="description" content={description} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={fullUrl} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullUrl} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonData)} />

<Font cssVariable="--font-monospace" preload />
